// About - calculation info
"This app uses Widmark's method to calculate blood alcohol content (BAC)." = "This app uses Widmark's method to calculate blood alcohol content (BAC).";
"Calculation:" = "Calculation:";
"‰ BAC = (Volume × % Alcohol × 0.789) / (Body Weight × Constant) × 1000" = "‰ BAC = (Volume × % Alcohol × 0.789) / (Body Weight × Constant) × 1000";
"Where:" = "Where:";
"• Volume: Drink volume in ml" = "• Volume: Drink volume in ml";
"• % Alcohol: Alcohol percentage of the drink" = "• % Alcohol: Alcohol percentage of the drink";
"• 0.789: Density of ethanol (g/cm³)" = "• 0.789: Density of ethanol (g/cm³)";
"• Body Weight: User's weight in kg" = "• Body Weight: User's weight in kg";
"• Constant: Proportion of water in the body (0.68 for males, 0.55 for females)" = "• Constant: Proportion of water in the body (0.68 for males, 0.55 for females)";
"Sources:" = "Sources:";
"Kubička, J. 2011. Metody a principy měření alkoholu v těle. Theses.cz" = "Kubička, J. 2011. Metody a principy měření alkoholu v těle. Theses.cz";
